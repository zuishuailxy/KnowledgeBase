<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: "Microsoft YaHei", Arial, sans-serif;
        background: #f5f5f5;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
      }
      .header {
        background: #1a73e8;
        color: #fff;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        font-size: 22px;
      }
      .body {
        padding: 30px;
        color: #333;
        line-height: 1.8;
      }
      .footer {
        background: #f9f9f9;
        padding: 15px 30px;
        text-align: center;
        font-size: 12px;
        color: #999;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>{{projectName}}</h1>
      </div>
      <div class="body">
        {{{body}}}
      </div>
      <div class="footer">
        <p>© {{year}} {{projectName}} 版权所有</p>
        <p>此邮件由系统自动发送，请勿回复。</p>
      </div>
    </div>
  </body>
</html>